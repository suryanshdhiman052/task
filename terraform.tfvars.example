aws_region     = "us-east-1"
project        = "catalog"
environment    = "prod"
domain_name    = "api.example.com"
hosted_zone_id = "ZXXXXXXXXXXXXX"

# Optional: after scripts/push-api.sh, point at the ECR URL from `terraform output ecr_repository_url`
# and set container_command = [] so the image CMD (node /app/server.js) runs instead of the inline listener.
# container_image   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/catalog-prod:latest"
# container_command = []
# health_path       = "/healthz"
